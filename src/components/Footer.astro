---
import { SITE } from '@/site.config';
const year = new Date().getFullYear();
---
<footer class="border-t border-line bg-ink text-paper">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-5 px-5 pt-8 pb-28 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12">
    <div><p class="font-display text-xl">{SITE.name}<span class="text-signal">.</span></p><p class="mt-1 font-mono text-[8px] uppercase tracking-[.16em] text-paper/45">© {year} · 3D Artist / Apparel Engineering / Digital Product Visualisation</p></div>
    <div class="flex flex-wrap items-center gap-5 font-mono text-[9px] uppercase tracking-wider text-paper/65"><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-signal">LinkedIn ↗</a><a href="#top" class="hover:text-signal">Back to top ↑</a></div>
  </div>
</footer>
