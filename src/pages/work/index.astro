---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkRow from '@/components/WorkRow.astro';

const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<BaseLayout title="Selected Work" description="Selected apparel engineering, technical design and 3D product visualisation projects by Imtiaz Asif.">
  <section class="mx-auto max-w-7xl px-5 pt-16 pb-24 sm:px-8 sm:pt-24">
    <p class="font-mono text-[10px] uppercase tracking-[.2em] text-signal">Portfolio / Projects</p>
    <h1 class="mt-4 font-display text-5xl tracking-tight sm:text-6xl">Selected work.</h1>
    <p class="mt-5 max-w-xl text-sm leading-6 text-ink-soft">Apparel development, technical design and digital product visualisation. Each case study will document the brief, contribution, process and deliverables.</p>
    <div class="mt-12">
      {allWork.length ? <>{allWork.map((entry) => <WorkRow entry={entry} />)}</> : <div class="border border-line bg-surface p-8"><p class="font-mono text-[10px] uppercase tracking-[.16em] text-signal">Case studies in preparation</p><h2 class="mt-4 font-display text-3xl">Selected projects are being curated.</h2><p class="mt-3 max-w-lg text-sm leading-6 text-ink-soft">This portfolio will feature verified apparel and 3D projects rather than fictional starter examples. New case studies will appear here as their visuals and project details are prepared.</p><a href="/#contact" class="mt-6 inline-block font-mono text-xs text-signal">Discuss a project ↗</a></div>}
    </div>
  </section>
</BaseLayout>
