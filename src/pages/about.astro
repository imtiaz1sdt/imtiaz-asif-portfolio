---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';
const strengths = ['Textile engineering foundation', '3D garment and product visualisation', 'Technical design and garment communication', 'Digital presentation and motion'];
---
<BaseLayout title="About" description={`About ${SITE.name} — textile engineering, 3D apparel and digital product visualisation.`}>
  <section class="mx-auto max-w-7xl px-5 pb-24 pt-16 sm:px-8 sm:pt-24">
    <p class="font-mono text-[10px] uppercase tracking-[.2em] text-signal">About / Background</p>
    <h1 class="mt-5 max-w-4xl font-display text-5xl leading-[1.02] tracking-tight sm:text-7xl">Where textile knowledge meets digital craft.</h1>
    <div class="mt-12 grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="prose prose-invert max-w-2xl text-sm leading-7">
        <p>I am a textile engineer and 3D artist working at the intersection of apparel development, technical design and digital product visualisation.</p>
        <p>My approach brings product understanding into the visual process: how a garment is shaped, how its materials and details work, and how those decisions can be communicated clearly through technical and digital presentation.</p>
        <p>I enjoy work that connects creative direction with practical execution — from garment visuals and technical communication to rendered assets and motion-led presentation.</p>
      </div>
      <aside class="border border-line bg-surface p-7">
        <p class="font-mono text-[10px] uppercase tracking-[.16em] text-signal">Areas of practice</p>
        <ul class="mt-6 space-y-4">{strengths.map((item) => <li class="flex gap-3 border-b border-line pb-4 text-sm"><span class="text-signal">↗</span>{item}</li>)}</ul>
        <p class="mt-6 text-xs leading-5 text-ink-soft">Professional experience, selected clients and measurable project outcomes will be added with verified details.</p>
      </aside>
    </div>
    <div class="mt-12"><SectionHeading eyebrow="Let's connect"/><Button href={`mailto:${SITE.email}`}>Contact me ↗</Button></div>
  </section>
</BaseLayout>
