---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/site.config';
const strengths = ['Textile engineering and material understanding','Apparel design and garment development','3D garment and product visualisation','Technical design and product communication','Motion, image and digital presentation'];
---
<BaseLayout title="About" description={`About ${SITE.name} — apparel engineering, 3D and digital product visualisation.`}>
  <section class="mx-auto max-w-[1440px] px-5 pb-24 pt-16 sm:px-8 sm:pt-24 lg:px-12">
    <p class="font-mono text-[9px] uppercase tracking-[.2em] text-signal">About / Background</p>
    <h1 class="mt-5 max-w-5xl font-display text-5xl leading-[.92] tracking-[-.05em] sm:text-7xl">An apparel mindset.<br/><span class="text-signal">A digital skill set.</span></h1>
    <div class="mt-14 grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="max-w-2xl space-y-5 text-sm leading-7 text-ink-soft"><p class="font-display text-2xl leading-relaxed text-ink">I am a textile engineer and 3D artist working across apparel development, technical design and digital product visualisation.</p><p>My background helps me look beyond the appearance of a garment and consider its form, material, construction and intended use. I bring that product understanding into visual development — from technical flats and garment details to 3D models, material studies and digital presentation.</p><p>I am interested in work where design thinking and practical execution meet: communicating product ideas clearly, refining details, and building digital assets that help teams and clients understand a product before it exists physically.</p><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-3 border border-line px-5 py-3 font-mono text-[10px] uppercase tracking-wider text-ink transition-colors hover:border-signal hover:text-signal">Connect on LinkedIn ↗</a></div>
      <aside class="border border-line bg-surface p-7 sm:p-9"><p class="font-mono text-[9px] uppercase tracking-[.16em] text-signal">Areas of practice</p><ul class="mt-7 space-y-4">{strengths.map((item,i)=><li class="flex gap-4 border-b border-line pb-4 text-sm"><span class="font-mono text-[10px] text-signal">0{i+1}</span><span>{item}</span></li>)}</ul><p class="mt-7 text-xs leading-5 text-ink-soft">Detailed career history, selected clients and measurable project outcomes will be added with verified details and approved portfolio material.</p></aside>
    </div>
  </section>
</BaseLayout>
