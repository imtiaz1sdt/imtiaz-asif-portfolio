---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE, NAV_LINKS } from '@/site.config';
const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-xl">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-5 px-5 py-3.5 sm:px-8 lg:px-12">
    <a href="/" class="group shrink-0" aria-label={SITE.name + ' home'}>
      <span class="font-display text-lg font-semibold tracking-[-.04em] sm:text-xl">{SITE.name}<span class="text-signal">.</span></span>
      <span class="mt-0.5 hidden font-mono text-[8px] uppercase tracking-[.17em] text-ink-soft sm:block">Apparel / 3D / Technical</span>
    </a>
    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary navigation">
      {NAV_LINKS.map((link) => {
        const sectionAnchor = link.href.startsWith('/#');
        const active = !sectionAnchor && (currentPath === link.href || currentPath.startsWith(`${link.href}/`));
        return <a href={link.href} aria-current={active ? 'page' : undefined} class:list={['shrink-0 font-mono text-[9px] uppercase tracking-[.16em] transition-colors hover:text-signal', active ? 'text-signal' : 'text-ink-soft']}>{link.label}</a>;
      })}
      <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="border border-line px-3.5 py-2 font-mono text-[9px] uppercase tracking-[.14em] text-ink transition-colors hover:border-signal hover:text-signal">LinkedIn ↗</a>
      <ThemeToggle />
    </nav>
    <div class="flex items-center gap-3 lg:hidden">
      <details class="relative">
        <summary class="cursor-pointer list-none font-mono text-[9px] uppercase tracking-wider text-ink-soft">Menu <span class="text-signal">＋</span></summary>
        <div class="absolute right-0 top-8 z-50 min-w-48 border border-line bg-surface p-3 shadow-2xl">
          {NAV_LINKS.map((link) => <a href={link.href} class="block px-3 py-3 font-mono text-[10px] uppercase tracking-wider text-ink-soft hover:text-signal">{link.label}</a>)}
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="block border-t border-line px-3 py-3 font-mono text-[10px] uppercase tracking-wider text-signal">LinkedIn ↗</a>
        </div>
      </details>
      <ThemeToggle />
    </div>
  </div>
</header>
