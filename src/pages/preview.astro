---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Portfolio Template Preview" description="Visual template showroom for the Imtiaz Asif portfolio.">
  <main class="template-showroom mx-auto max-w-[1600px] px-4 pb-24 pt-10 sm:px-8 sm:pt-14 lg:px-12">
    <div class="showroom-intro flex flex-col justify-between gap-6 border-b border-line pb-8 lg:flex-row lg:items-end">
      <div>
        <p class="font-mono text-[9px] uppercase tracking-[.22em] text-signal">Imtiaz Asif / Portfolio design system</p>
        <h1 class="mt-4 max-w-4xl font-display text-4xl leading-[.96] tracking-[-.06em] sm:text-6xl">The portfolio, <span class="text-signal">in preview.</span></h1>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-ink-soft">A visual showroom for every page type. Switch between layouts, compare how the story flows, then choose the direction before we populate it with your real work.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="showroom-chip"><span class="h-1.5 w-1.5 rounded-full bg-[#8589ff]"></span> DARK / EDITORIAL</span>
        <span class="showroom-chip">DESKTOP + MOBILE</span>
      </div>
    </div>

    <div class="showroom-toolbar sticky top-[58px] z-30 mt-7 flex flex-col gap-3 border border-line bg-paper/95 p-3 backdrop-blur-xl sm:top-[66px] sm:flex-row sm:items-center sm:justify-between">
      <nav class="showroom-tabs flex gap-1 overflow-x-auto" aria-label="Choose a page template" role="tablist">
        <button class="showroom-tab is-active" role="tab" aria-selected="true" data-preview-tab="home">01 Home</button>
        <button class="showroom-tab" role="tab" aria-selected="false" data-preview-tab="work">02 Work</button>
        <button class="showroom-tab" role="tab" aria-selected="false" data-preview-tab="category">03 Category</button>
        <button class="showroom-tab" role="tab" aria-selected="false" data-preview-tab="case">04 Case study</button>
        <button class="showroom-tab" role="tab" aria-selected="false" data-preview-tab="studio">05 3D Studio</button>
        <button class="showroom-tab" role="tab" aria-selected="false" data-preview-tab="process">06 Process</button>
        <button class="showroom-tab" role="tab" aria-selected="false" data-preview-tab="about">07 About</button>
        <button class="showroom-tab" role="tab" aria-selected="false" data-preview-tab="contact">08 Contact</button>
      </nav>
      <div class="flex shrink-0 items-center gap-2">
        <span class="mr-1 font-mono text-[8px] uppercase tracking-[.15em] text-ink-soft">Viewport</span>
        <button class="showroom-size is-active" data-preview-size="desktop" aria-pressed="true">Desktop</button>
        <button class="showroom-size" data-preview-size="mobile" aria-pressed="false">Mobile</button>
      </div>
    </div>

    <div class="mt-5 flex items-center justify-between gap-3">
      <p class="font-mono text-[8px] uppercase tracking-[.16em] text-ink-soft">Live design concept / <span id="preview-current" class="text-signal">01 — Home</span></p>
      <p class="font-mono text-[8px] uppercase tracking-[.16em] text-ink-soft">Sample imagery only · not portfolio claims</p>
    </div>

    <div id="preview-canvas" class="preview-canvas mt-4">
      <!-- HOME -->
      <section class="preview-panel is-active" data-preview-panel="home" role="tabpanel">
        <div class="demo-screen demo-home">
          <div class="demo-nav"><span>IMTIAZ ASIF<span class="text-[#a8aaff]">.</span></span><span class="demo-nav-right">APPAREL / 3D / DIGITAL PRODUCT <b>◐</b></span></div>
          <div class="demo-home-art" style="background-image:linear-gradient(90deg,#090b10 0%,#090b10cc 36%,#090b1030 100%),url('https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1800&q=85')"></div>
          <div class="demo-home-copy"><p class="demo-eyebrow">APPAREL ENGINEERING × DIGITAL PRODUCT CRAFT</p><h2>Apparel.<br/><span>Engineered</span><br/>in 3D.</h2><p>Design intelligence meets digital craft. From product concept and technical development to compelling 3D visualisation.</p></div>
          <div class="demo-home-bottom"><div class="demo-home-links"><span>01 &nbsp; WORK ↗</span><span>02 &nbsp; PROCESS ↗</span><span>03 &nbsp; ABOUT ↗</span><span>04 &nbsp; CONTACT ↗</span></div><p>3D ARTIST / APPAREL ENGINEERING / DIGITAL PRODUCT</p></div>
        </div>
        <div class="preview-caption"><div><h2>01 / Home — cinematic introduction</h2><p>Keep the first screen minimal. One memorable 3D or campaign visual, a clear professional positioning line, and four direct paths into the portfolio.</p></div><a href="/" class="preview-open">Open live page ↗</a></div>
      </section>

      <!-- WORK -->
      <section class="preview-panel" data-preview-panel="work" role="tabpanel" hidden>
        <div class="demo-screen demo-page">
          <div class="demo-page-top"><p class="demo-eyebrow">PORTFOLIO / SELECTED WORK</p><div class="demo-meta">01—04 / DISCIPLINES</div></div>
          <h2 class="demo-display">Selected work.<br/><span>Distinct disciplines.</span></h2>
          <p class="demo-lead">A curated index of product thinking, garment development and digital visualisation.</p>
          <div class="demo-work-grid">
            <article class="demo-work-card"><img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=1000&q=80" alt="White t-shirt product study"/><div><small>01 / APPAREL DESIGN</small><h3>Product & garment design</h3><p>Silhouette, colour, details and design direction.</p></div></article>
            <article class="demo-work-card"><img src="https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&fit=crop&w=1000&q=80" alt="Fashion apparel visual reference"/><div><small>02 / 3D VISUALISATION</small><h3>3D apparel & product</h3><p>Digital garments, materials, lighting and renders.</p></div></article>
            <article class="demo-work-card"><img src="https://images.unsplash.com/photo-1598033129183-c4f50c736f10?auto=format&fit=crop&w=1000&q=80" alt="Tailored garment detail"/><div><small>03 / TECHNICAL DESIGN</small><h3>Technical design</h3><p>Flats, construction details and tech packs.</p></div></article>
            <article class="demo-work-card"><img src="https://images.unsplash.com/photo-1531058020387-3be344556be6?auto=format&fit=crop&w=1000&q=80" alt="Creative light and motion installation"/><div><small>04 / MOTION & VISUALS</small><h3>Motion & storytelling</h3><p>Animation, product stories and visual systems.</p></div></article>
          </div>
        </div>
        <div class="preview-caption"><div><h2>02 / Work — capability-led index</h2><p>Lead with four strong image cards. Recruiters can understand your range immediately, while each discipline has a focused landing page.</p></div><a href="/work" class="preview-open">Open live page ↗</a></div>
      </section>

      <!-- CATEGORY -->
      <section class="preview-panel" data-preview-panel="category" role="tabpanel" hidden>
        <div class="demo-screen demo-page">
          <div class="demo-page-top"><p class="demo-eyebrow">01 / CATEGORY — 3D APPAREL</p><div class="demo-meta">SELECTED PROJECTS · 04</div></div>
          <h2 class="demo-display">3D apparel<br/><span>visualisation.</span></h2>
          <p class="demo-lead">Digital garments built to communicate silhouette, material, fit and product intent.</p>
          <div class="demo-filter-row"><span class="active">ALL PROJECTS 04</span><span>GARMENTS</span><span>MATERIAL STUDIES</span><span>CAMPAIGN VISUALS</span></div>
          <div class="demo-category-grid">
            <article><img src="https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=1200&q=80" alt="Apparel clothing on rack"/><small>01 / 3D GARMENT DEVELOPMENT</small><h3>Digital garment study</h3><p>Silhouette · Fabric · Presentation</p></article>
            <article><img src="https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&fit=crop&w=1200&q=80" alt="Apparel visual direction"/><small>02 / PRODUCT VISUALISATION</small><h3>Product image system</h3><p>Lighting · Materials · Render</p></article>
          </div>
        </div>
        <div class="preview-caption"><div><h2>03 / Category — focused project gallery</h2><p>Give each discipline its own visual language and filters. Project tiles should use your strongest relevant images, not generic thumbnails.</p></div><a href="/work/category/3d-visualisation" class="preview-open">Open live page ↗</a></div>
      </section>

      <!-- CASE STUDY -->
      <section class="preview-panel" data-preview-panel="case" role="tabpanel" hidden>
        <div class="demo-screen demo-page">
          <div class="demo-page-top"><p class="demo-eyebrow">CASE STUDY / APPAREL DEVELOPMENT</p><div class="demo-meta">PROJECT 001</div></div>
          <div class="demo-case-head"><div><h2 class="demo-display">From concept<br/>to <span>digital product.</span></h2><p class="demo-lead">A complete apparel development story, connecting design intent, technical detail and final 3D presentation.</p></div><div class="demo-facts"><div><small>ROLE</small><b>Design & 3D development</b></div><div><small>DELIVERABLES</small><b>3D / Flats / Tech pack</b></div><div><small>DISCIPLINE</small><b>Apparel engineering</b></div></div></div>
          <div class="demo-case-hero"><img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=1800&q=85" alt="Minimal apparel product image"/><span>01 / FINAL PRODUCT DIRECTION</span></div>
          <div class="demo-case-lower"><div><small>02 / DEVELOPMENT STORY</small><h3>Design decisions, made visible.</h3></div><div class="demo-case-thumbs"><img src="https://images.unsplash.com/photo-1598033129183-c4f50c736f10?auto=format&fit=crop&w=700&q=80" alt="Garment construction detail"/><img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=700&q=80" alt="Textile surface study"/><img src="https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&fit=crop&w=700&q=80" alt="Apparel visual reference"/></div></div>
        </div>
        <div class="preview-caption"><div><h2>04 / Case study — proof, not just pictures</h2><p>This is the most important page for hiring. Show the brief, your exact contribution, design iterations, technical flats, fabric/material work, final renders and deliverables in a clear sequence.</p></div><a href="/work" class="preview-open">View work structure ↗</a></div>
      </section>

      <!-- 3D STUDIO -->
      <section class="preview-panel" data-preview-panel="studio" role="tabpanel" hidden>
        <div class="demo-screen demo-page demo-studio-page">
          <div class="demo-page-top"><p class="demo-eyebrow">INTERACTIVE SPACE / 3D STUDIO</p><div class="demo-meta">MODEL VIEWER / 001</div></div>
          <div class="demo-studio-head"><h2 class="demo-display">A closer look<br/>at <span>the object.</span></h2><p class="demo-lead">An interactive stage for digital garments and product assets. Rotate, inspect and explore the model in context.</p></div>
          <div class="demo-viewer"><div class="viewer-grid"></div><div class="viewer-orbit"></div><img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=900&q=85" alt="Garment visual placeholder" /><span class="viewer-label">MODEL PREVIEW / REPLACE WITH ORIGINAL 3D ASSET</span><span class="viewer-controls">＋ &nbsp; − &nbsp; ⟳</span></div>
          <div class="demo-viewer-foot"><span>GARMENT 001 / DIGITAL SAMPLE</span><span>BLENDER · CLO / 3D PRESENTATION</span></div>
        </div>
        <div class="preview-caption"><div><h2>05 / 3D Studio — interactive proof</h2><p>Use the live Sketchfab viewer only for original or approved models. Place technical callouts and project context beside it so the 3D feature supports the case study.</p></div><a href="/3d-studio" class="preview-open">Open live page ↗</a></div>
      </section>

      <!-- PROCESS -->
      <section class="preview-panel" data-preview-panel="process" role="tabpanel" hidden>
        <div class="demo-screen demo-page">
          <div class="demo-page-top"><p class="demo-eyebrow">METHOD / PROCESS & WORKFLOW</p><div class="demo-meta">TWO CONNECTED SYSTEMS</div></div>
          <h2 class="demo-display">A clear route<br/><span>from idea to output.</span></h2>
          <p class="demo-lead">A structured process that keeps garment feasibility and visual quality connected.</p>
          <div class="demo-flow-grid">
            <article><small>A / APPAREL DEVELOPMENT</small><h3>Design to technical handoff</h3><div class="demo-flow-line"><span>01</span><b>Brief & product intent</b></div><div class="demo-flow-line"><span>02</span><b>Design development</b></div><div class="demo-flow-line"><span>03</span><b>Technical development</b></div><div class="demo-flow-line"><span>04</span><b>Review & refinement</b></div><div class="demo-flow-line"><span>05</span><b>Development handoff</b></div></article>
            <article><small>B / 3D VISUAL PRODUCTION</small><h3>Digital build to final presentation</h3><div class="demo-flow-line"><span>01</span><b>Reference & asset intake</b></div><div class="demo-flow-line"><span>02</span><b>3D build & refinement</b></div><div class="demo-flow-line"><span>03</span><b>Material & look development</b></div><div class="demo-flow-line"><span>04</span><b>Render, motion & interaction</b></div><div class="demo-flow-line"><span>05</span><b>Optimise & deliver</b></div></article>
          </div>
        </div>
        <div class="preview-caption"><div><h2>06 / Process — two clear workflows</h2><p>Keep apparel product development separate from 3D production, then show where they connect. This differentiates your engineering knowledge from purely visual artists.</p></div><a href="/process" class="preview-open">Open live page ↗</a></div>
      </section>

      <!-- ABOUT -->
      <section class="preview-panel" data-preview-panel="about" role="tabpanel" hidden>
        <div class="demo-screen demo-page">
          <div class="demo-page-top"><p class="demo-eyebrow">PROFILE / ABOUT</p><div class="demo-meta">IMTIAZ ASIF · PROFESSIONAL PROFILE</div></div>
          <div class="demo-about-grid"><div><h2 class="demo-display">A textile engineer<br/>working in <span>3D.</span></h2><p class="demo-lead">I connect apparel knowledge, technical design and digital product visualisation — bridging how a garment is developed with how it is communicated.</p><div class="demo-about-stats"><div><small>EDUCATION</small><b>BSc Textile Engineering</b></div><div><small>ROLE</small><b>Design Director</b></div><div><small>FOCUS</small><b>Apparel × 3D</b></div></div></div><div class="demo-about-visual"><img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1200&q=80" alt="Close-up textile material"/><span>PRODUCT KNOWLEDGE<br/>× DIGITAL CRAFT</span></div></div>
          <div class="demo-capability-strip"><div><small>01 / CAPABILITY</small><b>Apparel development</b></div><div><small>02 / CAPABILITY</small><b>3D visualisation</b></div><div><small>03 / CAPABILITY</small><b>Technical communication</b></div><div><small>04 / CAPABILITY</small><b>Visual storytelling</b></div></div>
          <div class="demo-tools"><small>PRODUCTION TOOLKIT</small><div>BLENDER <i>·</i> MAYA <i>·</i> ZBRUSH <i>·</i> SUBSTANCE 3D <i>·</i> PHOTOSHOP <i>·</i> ILLUSTRATOR <i>·</i> AFTER EFFECTS</div></div>
        </div>
        <div class="preview-caption"><div><h2>07 / About — professional positioning</h2><p>Use an editorial layout, not a long biography. Lead with the rare combination of textile engineering and 3D, then support it with capabilities, tools, experience and recruiter-relevant role alignment.</p></div><a href="/about" class="preview-open">Open live page ↗</a></div>
      </section>

      <!-- CONTACT -->
      <section class="preview-panel" data-preview-panel="contact" role="tabpanel" hidden>
        <div class="demo-screen demo-contact">
          <div class="demo-nav"><span>IMTIAZ ASIF<span class="text-[#a8aaff]">.</span></span><span class="demo-nav-right">CONTACT / COLLABORATION</span></div>
          <div class="demo-contact-content"><div><p class="demo-eyebrow">HAVE A PROJECT IN MIND?</p><h2>Let's make<br/><span>something</span><br/>tangible.</h2><p>For apparel design, technical development, 3D product visualisation and digital product roles.</p><a>CONNECT ON LINKEDIN ↗</a></div><aside><small>AVAILABLE FOR</small><b>Apparel & product design</b><b>3D visualisation</b><b>Technical development</b><b>Creative collaboration</b><div class="demo-contact-note">Dhaka, Bangladesh<br/>Working internationally</div></aside></div>
          <div class="demo-contact-bottom"><span>IMTIAZ ASIF / PORTFOLIO</span><span>LINKEDIN MESSAGE ↗</span></div>
        </div>
        <div class="preview-caption"><div><h2>08 / Contact — one obvious next action</h2><p>Keep the close direct. A strong statement, concise collaboration scope and a single LinkedIn action make it effortless for recruiters and clients to reach you.</p></div><a href="/contact" class="preview-open">Open live page ↗</a></div>
      </section>
    </div>

    <div class="showroom-footer mt-10 flex flex-col justify-between gap-4 border-t border-line pt-6 sm:flex-row sm:items-center">
      <div><p class="font-mono text-[9px] uppercase tracking-[.16em] text-signal">Design direction</p><p class="mt-2 text-sm text-ink-soft">Graphite canvas · editorial typography · lavender signal · large product imagery · clear technical proof.</p></div>
      <a href="/work" class="inline-flex items-center justify-center border border-signal px-5 py-3 font-mono text-[9px] uppercase tracking-wider text-signal transition-colors hover:bg-signal hover:text-white">Return to portfolio ↗</a>
    </div>
  </main>
</BaseLayout>

<style>
  .showroom-chip{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);padding:9px 11px;font:8px var(--ff-mono);letter-spacing:.13em;color:var(--ink-soft)}
  .showroom-toolbar{border-radius:4px}
  .showroom-tabs{scrollbar-width:none}
  .showroom-tabs::-webkit-scrollbar{display:none}
  .showroom-tab,.showroom-size{white-space:nowrap;border:1px solid transparent;padding:10px 12px;font:9px var(--ff-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);transition:all .2s}
  .showroom-tab:hover,.showroom-size:hover{color:var(--ink);border-color:var(--line)}
  .showroom-tab.is-active,.showroom-size.is-active{background:var(--signal);border-color:var(--signal);color:#fff}
  .preview-panel[hidden]{display:none}
  .demo-screen{position:relative;overflow:hidden;border:1px solid var(--line);background:#0c0e12;color:#f0f1f4;min-height:560px;transition:max-width .25s ease,margin .25s ease}
  .preview-canvas.is-mobile .demo-screen{max-width:430px;margin-inline:auto;min-height:780px}
  .demo-nav{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;padding:22px 5%;font:600 12px var(--ff-display);letter-spacing:-.03em}
  .demo-nav-right{font:8px var(--ff-mono);letter-spacing:.16em;color:#9297a3}
  .demo-nav-right b{margin-left:18px;color:#aaaaff;font-size:14px}
  .demo-home{min-height:690px;background:#090b10}
  .demo-home-art{position:absolute;inset:0 0 0 22%;background-size:cover;background-position:center 38%;opacity:.82}
  .demo-home-copy{position:relative;z-index:1;width:min(660px,72%);padding:92px 7% 130px}
  .demo-eyebrow{font:9px var(--ff-mono);letter-spacing:.2em;color:#a8aaff}
  .demo-home-copy h2,.demo-contact-content h2{margin-top:20px;font:700 clamp(48px,8vw,104px)/.88 var(--ff-display);letter-spacing:-.075em}
  .demo-home-copy h2 span,.demo-contact-content h2 span{color:#a8aaff}
  .demo-home-copy>p:last-child{max-width:430px;margin-top:24px;color:#a7aab4;font-size:13px;line-height:1.8}
  .demo-home-bottom{position:absolute;bottom:0;left:0;right:0;padding:0 5% 24px}
  .demo-home-links{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #ffffff35;background:#ffffff08;backdrop-filter:blur(18px)}
  .demo-home-links span{padding:20px 12px;border-right:1px solid #ffffff25;font:9px var(--ff-mono);letter-spacing:.1em}
  .demo-home-links span:last-child{border:0}
  .demo-home-bottom>p{margin-top:12px;color:#727987;font:8px var(--ff-mono);letter-spacing:.15em}
  .demo-page{padding:5%}
  .demo-page-top{display:flex;justify-content:space-between;gap:20px;color:#a8aaff}
  .demo-meta{font:8px var(--ff-mono);letter-spacing:.13em;color:#7d8390}
  .demo-display{margin-top:34px;font:650 clamp(43px,6.5vw,78px)/.94 var(--ff-display);letter-spacing:-.07em}
  .demo-display span{color:#a8aaff}
  .demo-lead{max-width:620px;margin-top:20px;color:#9da3af;font-size:13px;line-height:1.8}
  .demo-work-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:42px}
  .demo-work-card{position:relative;overflow:hidden;min-height:220px;background:#171c25}
  .demo-work-card img{width:100%;height:190px;object-fit:cover;filter:saturate(.72);opacity:.87;transition:transform .4s}
  .demo-work-card:hover img{transform:scale(1.025)}
  .demo-work-card>div{padding:16px 18px 18px}
  .demo-work-card small,.demo-category-grid small,.demo-case-lower small{font:8px var(--ff-mono);letter-spacing:.14em;color:#a8aaff}
  .demo-work-card h3,.demo-category-grid h3{margin-top:8px;font:500 20px var(--ff-display);letter-spacing:-.035em}
  .demo-work-card p,.demo-category-grid p{margin-top:6px;color:#9097a4;font-size:11px;line-height:1.6}
  .demo-filter-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:32px;border-bottom:1px solid #ffffff24;padding-bottom:14px}
  .demo-filter-row span{border:1px solid #ffffff25;padding:9px 12px;color:#89909d;font:8px var(--ff-mono);letter-spacing:.1em}
  .demo-filter-row .active{border-color:#a8aaff;color:#c4c5ff}
  .demo-category-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;margin-top:22px}
  .demo-category-grid img{width:100%;height:240px;object-fit:cover;background:#191e28}
  .demo-category-grid small{display:block;margin-top:15px}
  .demo-case-head{display:grid;grid-template-columns:1.3fr .7fr;gap:35px;align-items:end}
  .demo-case-head .demo-display{margin-top:28px}
  .demo-facts{display:grid;grid-template-columns:1fr 1fr;gap:18px;border-top:1px solid #ffffff28;padding-top:18px}
  .demo-facts div{display:grid;gap:8px}
  .demo-facts small,.demo-about-stats small,.demo-capability-strip small{font:8px var(--ff-mono);letter-spacing:.14em;color:#a8aaff}
  .demo-facts b,.demo-about-stats b{font:11px var(--ff-body);font-weight:500}
  .demo-case-hero{position:relative;margin-top:36px;background:#171c25}
  .demo-case-hero img{width:100%;height:300px;object-fit:cover;filter:saturate(.72)}
  .demo-case-hero span{position:absolute;left:18px;bottom:16px;padding:8px 10px;background:#090b10cc;font:8px var(--ff-mono);letter-spacing:.14em;color:#c6c8d0}
  .demo-case-lower{display:grid;grid-template-columns:.55fr 1.45fr;gap:25px;align-items:start;margin-top:28px}
  .demo-case-lower h3{margin-top:10px;font:500 25px var(--ff-display);letter-spacing:-.04em}
  .demo-case-thumbs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  .demo-case-thumbs img{width:100%;height:120px;object-fit:cover}
  .demo-studio-head{display:grid;grid-template-columns:1fr .7fr;gap:30px;align-items:end}
  .demo-studio-head .demo-display{margin-top:28px}
