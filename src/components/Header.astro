---
import { SITE, NAV_LINKS } from '@/site.config';
const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-4 sm:px-8">
    <a href="/" class="group shrink-0" aria-label={SITE.name + ' home'}>
      <span class="font-display text-lg tracking-wide">{SITE.name}</span>
      <span class="mt-0.5 block font-mono text-[9px] tracking-[.18em] text-ink-soft">3D / APPAREL / VISUALISATION</span>
    </a>
    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {NAV_LINKS.map((link) => {
        const active = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return <a href={link.href} aria-current={active ? 'page' : undefined} class:list={['font-mono text-[10px] uppercase tracking-[.14em] transition-colors hover:text-signal', active ? 'text-signal' : 'text-ink-soft']}>{link.label}</a>;
      })}
      <a href="/#contact" class="border border-line px-4 py-2 font-mono text-[10px] uppercase tracking-wider transition-colors hover:border-signal hover:text-signal">Contact ↗</a>
    </nav>
    <a href="/#contact" class="font-mono text-[10px] uppercase text-signal md:hidden">Contact ↗</a>
  </div>
</header>
