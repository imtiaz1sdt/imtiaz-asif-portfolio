---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/site.config';

const modelUrl = 'https://sketchfab.com/models/97611a53e3b846f69e0655b210f72b2f/embed?autostart=1&autospin=0.12&camera=0&ui_stop=0&dnt=1&ui_theme=dark';
---
<BaseLayout title={SITE.name} description={SITE.description}>
  <section class="relative isolate min-h-[100svh] overflow-hidden bg-[#090b10] text-white">
    <div class="absolute inset-0 -z-30 bg-[radial-gradient(ellipse_at_72%_44%,#323b604d_0%,transparent_42%),linear-gradient(115deg,#11151f_0%,#090b10_58%,#080a0e_100%)]"></div>
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <iframe
        title="Automatically rotating 3D garment background — demonstration model"
        src={modelUrl}
        class="absolute left-[18%] top-[-8%] h-[116%] w-[105%] min-w-[880px] border-0 opacity-90"
        style="pointer-events:none; filter:saturate(.82) contrast(1.06);"
        allow="autoplay"
        referrerpolicy="strict-origin-when-cross-origin"
        loading="eager"
        tabindex="-1"
        aria-hidden="true"
      ></iframe>
    </div>
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(90deg,#090b10_0%,#090b10eF_24%,#090b10a8_49%,#090b1040_100%)]"></div>
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(0deg,#090b10_0%,transparent_26%,transparent_74%,#090b10a6_100%)]"></div>

    <div class="relative mx-auto flex min-h-[100svh] max-w-[1600px] flex-col justify-end px-5 pb-5 pt-28 sm:px-8 sm:pb-7 lg:px-12">
      <div class="mb-12 max-w-3xl sm:mb-16">
        <p class="mb-5 flex items-center gap-3 font-mono text-[9px] uppercase tracking-[.24em] text-[#a9adff] sm:text-[10px]"><span class="h-px w-8 bg-[#8589ff]"></span> Apparel engineering × digital product craft</p>
        <h1 class="font-display text-[clamp(3.2rem,8.5vw,8.7rem)] font-medium leading-[.84] tracking-[-.065em] text-white">Apparel.<br/><span class="text-[#a4a8ff]">Engineered</span><br/>in 3D.</h1>
        <p class="mt-6 max-w-lg text-sm leading-6 text-white/65 sm:text-base">Imtiaz Asif — 3D Artist, Apparel Engineering & Digital Product Visualisation.</p>
      </div>

      <nav aria-label="Main portfolio sections" class="grid grid-cols-2 border-y border-white/20 sm:grid-cols-4">
        {[
          {label:'Work',index:'01',href:'/work'},
          {label:'Process / Workflow',index:'02',href:'/process'},
          {label:'About',index:'03',href:'/about'},
          {label:'Contact',index:'04',href:'/contact'},
        ].map((item) => (
          <a href={item.href} class="group flex items-center justify-between gap-3 border-b border-white/15 px-3 py-4 transition-colors hover:bg-white/5 sm:border-b-0 sm:px-5 sm:py-5 [&:nth-child(odd)]:border-r [&:nth-child(odd)]:border-white/15 sm:[&:not(:last-child)]:border-r sm:[&:not(:last-child)]:border-white/15">
            <span class="flex items-center gap-3"><span class="font-mono text-[9px] text-[#8589ff]">{item.index}</span><span class="font-mono text-[9px] uppercase tracking-[.12em] text-white/75 transition-colors group-hover:text-white sm:text-[10px]">{item.label}</span></span>
            <span class="text-xs text-white/35 transition-all group-hover:translate-x-1 group-hover:text-[#a4a8ff]">↗</span>
          </a>
        ))}
      </nav>
      <div class="mt-4 flex flex-col justify-between gap-2 font-mono text-[8px] uppercase tracking-[.12em] text-white/35 sm:flex-row sm:items-center">
        <span>3D Artist / Apparel Engineering / Digital Product Visualisation</span>
        <span>Background model: Hoodie by Virtual Pandora · CC BY</span>
      </div>
    </div>
  </section>
</BaseLayout>
