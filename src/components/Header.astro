---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE } from '@/site.config';
const isHome = Astro.url.pathname === '/';
---
{isHome ? (
  <header class="absolute inset-x-0 top-0 z-50">
    <div class="mx-auto flex max-w-[1600px] items-center justify-between px-5 py-5 sm:px-8 lg:px-12">
      <a href="/" class="home-brand font-display text-lg font-semibold tracking-[-.04em] text-white sm:text-xl">{SITE.name}<span class="text-signal">.</span></a>
      <div class="flex items-center gap-3"><span class="home-label hidden font-mono text-[8px] uppercase tracking-[.18em] text-white/45 sm:inline">Independent creative practice</span><ThemeToggle /></div>
    </div>
  </header>
) : (
  <header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur-xl">
    <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-5 px-5 py-3.5 sm:px-8 lg:px-12">
      <a href="/" class="group shrink-0" aria-label={SITE.name + ' home'}>
        <span class="font-display text-lg font-semibold tracking-[-.04em] sm:text-xl">{SITE.name}<span class="text-signal">.</span></span>
        <span class="mt-0.5 hidden font-mono text-[8px] uppercase tracking-[.17em] text-ink-soft sm:block">Apparel / 3D / Technical</span>
      </a>
      <ThemeToggle />
    </div>
  </header>
)}
