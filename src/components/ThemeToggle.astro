<button type="button" data-theme-toggle aria-label="Switch to light theme" aria-pressed="false" title="Switch theme" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:border-signal hover:text-signal">
  <svg data-theme-sun class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
  <svg data-theme-moon class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8 8.8 8.8 0 1 0 20.2 15.4Z"></path></svg>
</button>
<script>
  function initThemeToggle() {
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!button || button.dataset.bound) return;
    button.dataset.bound = 'true';
    const sync = () => {
      const light = document.documentElement.classList.contains('light');
      button.setAttribute('aria-pressed', String(light));
      button.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
      button.querySelector('[data-theme-sun]')?.classList.toggle('hidden', light);
      button.querySelector('[data-theme-moon]')?.classList.toggle('hidden', !light);
    };
    sync();
    button.addEventListener('click', () => {
      const light = document.documentElement.classList.toggle('light');
      try { localStorage.setItem('theme', light ? 'light' : 'dark'); } catch (_) {}
      sync();
    });
  }
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
