---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';
const allWork = await getCollection('work', ({ data }) => !data.draft);
const skills = [
  { n: '01', title: '3D & digital craft', text: 'Modelling, sculpting, texturing, materials, rendering and product visualisation.' },
  { n: '02', title: 'Apparel development', text: 'Garment form, detailing, trims, material understanding and product refinement.' },
  { n: '03', title: 'Technical communication', text: 'Technical flats, construction visuals, specifications and tech-pack development.' },
  { n: '04', title: 'Motion & storytelling', text: 'Animation, compositing and visual narratives for product presentation.' },
];
const tools = [
  { group: '3D / MODELLING', items: ['Blender', 'Autodesk Maya', 'ZBrush'] },
  { group: 'TEXTURING', items: ['Substance 3D Painter'] },
  { group: 'IMAGE / GRAPHIC', items: ['Adobe Photoshop', 'Adobe Illustrator'] },
  { group: 'MOTION', items: ['Adobe After Effects', 'Toon Boom'] },
];
const apparel = [
 ['01','Brief & product intent','Define the product, target user, brand direction, performance needs and constraints.'],
 ['02','Design & range direction','Develop silhouette, proportion, colour, materials, trims and visual language.'],
 ['03','Technical development','Resolve construction details, flats, measurements and specification communication.'],
 ['04','Review & refinement','Check the design against feedback, feasibility and consistency.'],
 ['05','Development handoff','Prepare approved visuals and technical information for sampling or production teams.'],
];
const visual = [
 ['01','Reference & asset preparation','Collect design references, garment information, dimensions and source assets.'],
 ['02','3D build & refinement','Create or refine geometry, garment form, details and scene structure.'],
 ['03','Material & look development','Build fabric response, surface qualities, lighting and camera language.'],
 ['04','Render, motion & interaction','Create still imagery, turntables, animation or interactive product views.'],
 ['05','Optimise & deliver','Prepare high-quality presentation files and lighter web-ready outputs.'],
];
---
<BaseLayout title={SITE.name} description={SITE.description}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="absolute right-[-7rem] top-[-10rem] h-[34rem] w-[34rem] rounded-full border border-ink/10"></div>
    <div class="absolute right-[-2rem] top-[-5rem] h-[24rem] w-[24rem] rounded-full border border-signal/25"></div>
    <div class="mx-auto grid max-w-[1440px] items-center gap-9 px-5 pb-16 pt-16 sm:px-8 sm:pb-24 sm:pt-24 lg:grid-cols-[1fr_.92fr] lg:gap-16 lg:px-12 lg:pt-28">
      <div class="relative z-10">
        <p class="flex items-center gap-3 font-mono text-[9px] uppercase tracking-[.2em] text-signal sm:text-[10px]"><span class="h-[2px] w-8 bg-signal"></span> Textile engineering × 3D visualisation</p>
        <h1 class="mt-8 font-display text-[clamp(3.6rem,8.8vw,8.5rem)] leading-[.84] tracking-[-.065em]">Form follows<br/><span class="italic text-signal">fabric.</span><br/>Vision follows<br/>form.</h1>
        <p class="mt-8 max-w-xl text-base leading-7 text-ink-soft sm:text-lg">{SITE.role}. I translate garment knowledge into technical clarity and compelling digital product experiences.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="#work" variant="solid">Explore selected work ↓</Button>
          <Button href={SITE.linkedin} variant="ghost">Connect on LinkedIn ↗</Button>
        </div>
        <p class="mt-12 font-mono text-[9px] uppercase tracking-[.15em] text-ink-soft">Apparel development <span class="px-2 text-signal">/</span> 3D product visuals <span class="px-2 text-signal">/</span> Technical design</p>
      </div>
      <div class="relative">
        <div class="relative min-h-[400px] overflow-hidden bg-ink sm:min-h-[560px]">
          <div class="absolute inset-0 opacity-25" style="background-image:linear-gradient(#eeeae122 1px,transparent 1px),linear-gradient(90deg,#eeeae122 1px,transparent 1px);background-size:28px 28px"></div>
          <div class="absolute left-5 top-5 z-10 font-mono text-[9px] uppercase tracking-[.18em] text-paper/70">Object study / 001</div>
          <div class="absolute right-5 top-5 z-10 font-mono text-[9px] text-signal">GARMENT / FORM</div>
          <div class="absolute inset-0 flex items-center justify-center p-6 sm:p-10">
            <svg class="w-full max-w-[490px]" viewBox="0 0 500 560" role="img" aria-label="Abstract technical garment study illustration">
              <defs><linearGradient id="coat" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#eeeae1"/><stop offset=".5" stop-color="#a9aaa1"/><stop offset="1" stop-color="#555a58"/></linearGradient><linearGradient id="coatShade" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#fff" stop-opacity=".45"/><stop offset="1" stop-color="#111" stop-opacity=".22"/></linearGradient></defs>
              <path d="M174 74 220 46q30 18 60 0l46 28 85 66-49 112-34-26 10 245q-88 24-176 0l10-245-34 26-49-112z" fill="url(#coat)" stroke="#f8f4ea" stroke-width="2.2"/>
              <path d="m174 74 46-28 30 86 30-86 46 28-40 70-36 24-36-24z" fill="#626965" stroke="#f8f4ea" stroke-width="2"/>
              <path d="M250 168v300M240 176v275" stroke="#222624" stroke-width="2.2"/>
              <path d="m167 232 47 13-7 78-47-10zm166 0-47 13 7 78 47-10z" fill="#5b625d" stroke="#f8f4ea" stroke-width="2"/>
              <path d="m92 140 43 112 35-26-22-112m260 26-43 112-35-26 22-112" fill="url(#coatShade)"/>
              <path d="M112 194 145 210m243-16-33 16M160 471q90 20 180 0" stroke="#e45132" stroke-width="3" fill="none"/>
              <path d="M185 270h28m84 0h28M180 328h32m76 0h32" stroke="#f6f1e8" stroke-width="1.6"/>
              <path d="M70 510h360" stroke="#eeeae1" stroke-opacity=".3"/>
              <path d="M85 500v20m330-20v20" stroke="#e45132" stroke-width="2"/>
            </svg>
          </div>
          <div class="absolute bottom-5 left-5 right-5 z-10 flex items-end justify-between gap-4 border-t border-paper/20 pt-4">
            <div><p class="font-mono text-[9px] uppercase tracking-wider text-paper/55">Digital garment concept</p><p class="mt-1 font-display text-xl text-paper">Structure / Surface / Form</p></div>
            <span class="font-mono text-[9px] text-signal">01 — 05</span>
          </div>
        </div>
        <div class="mt-3 flex justify-between font-mono text-[8px] uppercase tracking-[.13em] text-ink-soft"><span>Illustrative placeholder — replace with original 3D render</span><span>IMT / 001</span></div>
      </div>
    </div>
  </section>

  <div class="border-b border-line bg-surface">
    <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-x-8 gap-y-3 px-5 py-4 font-mono text-[9px] uppercase tracking-[.16em] text-ink-soft sm:px-8 lg:px-12">
      <span>01 / Apparel & garment design</span><span class="text-signal">✳</span><span>02 / 3D visualisation</span><span class="text-signal">✳</span><span>03 / Technical design</span><span class="text-signal">✳</span><span>04 / Motion & image</span>
    </div>
  </div>

  <section id="work" class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
    <div class="grid gap-5 md:grid-cols-[.9fr_1.1fr] md:items-end">
      <div><p class="font-mono text-[9px] uppercase tracking-[.2em] text-signal">01 / Selected work</p><h2 class="mt-4 font-display text-5xl tracking-[-.04em] sm:text-6xl">A closer look<br/>at the work.</h2></div>
      <p class="max-w-lg text-sm leading-6 text-ink-soft md:justify-self-end">The portfolio will be organised around the way apparel teams work: by product category, technical development and digital presentation. Each project will pair the finished visual with the process behind it.</p>
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      <a id="apparel" href="/work" class="group relative min-h-[310px] overflow-hidden bg-ink p-7 text-paper sm:min-h-[390px] sm:p-9">
        <div class="absolute inset-0 opacity-25 transition-opacity group-hover:opacity-40" style="background:radial-gradient(ellipse at 70% 40%,#a7a49b,transparent 58%)"></div>
        <div class="relative flex h-full min-h-[250px] flex-col justify-between"><div class="flex justify-between font-mono text-[9px] uppercase tracking-widest text-paper/60"><span>01 / Product design</span><span>↗</span></div><div><p class="font-mono text-[9px] uppercase tracking-widest text-signal">Category / Apparel</p><h3 class="mt-3 font-display text-4xl sm:text-5xl">Garment<br/>design &<br/>development</h3><p class="mt-4 max-w-sm text-xs leading-5 text-paper/65">Silhouettes, material stories, garment details and product ranges.</p></div></div>
      </a>
      <a id="visualisation" href="/work" class="group relative min-h-[310px] overflow-hidden border border-ink bg-[#d6d1c7] p-7 text-ink sm:min-h-[390px] sm:p-9">
        <div class="absolute -right-12 top-8 h-64 w-64 rounded-full border border-ink/20 transition-transform duration-700 group-hover:scale-110"></div><div class="absolute -right-2 top-16 h-48 w-48 rounded-full border border-signal/55"></div>
        <div class="relative flex h-full min-h-[250px] flex-col justify-between"><div class="flex justify-between font-mono text-[9px] uppercase tracking-widest text-ink/55"><span>02 / Digital production</span><span>↗</span></div><div><p class="font-mono text-[9px] uppercase tracking-widest text-signal">Category / 3D</p><h3 class="mt-3 font-display text-4xl sm:text-5xl">3D product<br/>visualisation</h3><p class="mt-4 max-w-sm text-xs leading-5 text-ink/65">Digital garments, material studies, still renders and 360° product presentation.</p></div></div>
      </a>
      <a href="/work" class="group border border-line bg-surface p-7 transition-colors hover:border-signal sm:p-9"><div class="flex justify-between font-mono text-[9px] uppercase tracking-widest text-ink-soft"><span>03 / Production communication</span><span class="text-signal">↗</span></div><h3 class="mt-10 font-display text-3xl sm:text-4xl">Technical design<br/>& tech packs</h3><p class="mt-4 max-w-md text-sm leading-6 text-ink-soft">Flats, construction details, measurement callouts, material references and clear handoff documentation.</p></a>
      <a href="/work" class="group border border-line bg-surface p-7 transition-colors hover:border-signal sm:p-9"><div class="flex justify-between font-mono text-[9px] uppercase tracking-widest text-ink-soft"><span>04 / Visual communication</span><span class="text-signal">↗</span></div><h3 class="mt-10 font-display text-3xl sm:text-4xl">Motion, image<br/>& experiments</h3><p class="mt-4 max-w-md text-sm leading-6 text-ink-soft">Product motion, compositing, visual storytelling and independent creative explorations.</p></a>
    </div>
    {allWork.length > 0 && <div class="mt-8 space-y-1">{allWork.map((entry) => <a class="block border-b border-line py-4 hover:text-signal" href={`/work/${entry.id}`}>{entry.data.title} <span class="float-right font-mono text-xs text-ink-soft">↗</span></a>)}</div>}
    <p class="mt-6 font-mono text-[9px] uppercase tracking-wider text-ink-soft">Project case studies and original visuals are being curated for publication.</p>
  </section>

  <section id="capabilities" class="bg-ink text-paper">
    <div class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
      <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr]">
        <div><p class="font-mono text-[9px] uppercase tracking-[.2em] text-signal">02 / Capabilities</p><h2 class="mt-4 font-display text-5xl leading-[.95] tracking-[-.04em] sm:text-6xl">Creative range.<br/>Technical depth.</h2><p class="mt-6 max-w-sm text-sm leading-6 text-paper/60">A connected skill set, shaped by textile engineering and years of digital product work.</p></div>
        <div class="grid gap-px border border-paper/20 bg-paper/20 sm:grid-cols-2">{skills.map((skill) => <article class="bg-ink p-6 sm:p-8"><p class="font-mono text-[9px] text-signal">{skill.n} / DISCIPLINE</p><h3 class="mt-7 font-display text-2xl">{skill.title}</h3><p class="mt-3 text-sm leading-6 text-paper/60">{skill.text}</p></article>)}</div>
      </div>
      <div class="mt-14 border-t border-paper/20 pt-8">
        <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end"><h3 class="font-display text-3xl">Software & tools</h3><p class="font-mono text-[9px] uppercase tracking-widest text-paper/45">Production toolkit</p></div>
        <div class="mt-8 grid gap-7 sm:grid-cols-2 lg:grid-cols-4">{tools.map((group) => <div><p class="mb-4 font-mono text-[9px] uppercase tracking-[.16em] text-signal">{group.group}</p><ul class="space-y-3">{group.items.map((item) => <li class="border-b border-paper/15 pb-3 text-sm text-paper/85">{item}</li>)}</ul></div>)}</div>
        <p class="mt-7 max-w-2xl text-xs leading-5 text-paper/45">Software names are listed by production role. We can add proficiency levels after reviewing which tools you use professionally, frequently or at an introductory level.</p>
      </div>
    </div>
  </section>

  <section id="process" class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
    <div class="grid gap-5 md:grid-cols-[1fr_.8fr] md:items-end"><div><p class="font-mono text-[9px] uppercase tracking-[.2em] text-signal">03 / Working process</p><h2 class="mt-4 font-display text-5xl leading-[.95] tracking-[-.04em] sm:text-6xl">From first brief<br/>to final presentation.</h2></div><p class="max-w-md text-sm leading-6 text-ink-soft md:justify-self-end">Two complementary workflows. One focuses on getting the garment right; the other focuses on communicating it through high-quality digital assets.</p></div>
    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      {[{label:'A / APPAREL DEVELOPMENT',title:'Design to production handoff',intro:'A product-aware path through design development and technical communication.',steps:apparel},{label:'B / 3D VISUALISATION',title:'Digital build to final output',intro:'A visual production path from source information to finished imagery and interactive assets.',steps:visual}].map((flow) => <article class="border-t-2 border-ink pt-6"><p class="font-mono text-[9px] uppercase tracking-[.16em] text-signal">{flow.label}</p><h3 class="mt-4 font-display text-3xl sm:text-4xl">{flow.title}</h3><p class="mt-3 max-w-md text-sm leading-6 text-ink-soft">{flow.intro}</p><div class="mt-7">{flow.steps.map((step) => <div class="grid grid-cols-[42px_1fr] gap-3 border-t border-line py-4"><span class="font-mono text-xs text-signal">{step[0]}</span><div><h4 class="text-sm font-medium">{step[1]}</h4><p class="mt-1 text-xs leading-5 text-ink-soft">{step[2]}</p></div></div>)}</div></article>)}
    </div>
  </section>

  <section class="border-y border-line bg-surface">
    <div class="mx-auto grid max-w-[1440px] gap-8 px-5 py-16 sm:px-8 lg:grid-cols-[.7fr_1.3fr] lg:px-12">
      <div><p class="font-mono text-[9px] uppercase tracking-[.2em] text-signal">04 / Background</p><h2 class="mt-4 font-display text-4xl leading-tight">Built on textile knowledge.<br/>Expanded through 3D.</h2></div>
      <div><p class="max-w-2xl font-display text-2xl leading-relaxed sm:text-3xl">I am a textile engineer and 3D artist working across apparel design, technical development and digital product visualisation.</p><p class="mt-5 max-w-xl text-sm leading-6 text-ink-soft">My work connects material and garment understanding with the visual craft needed to present products clearly — from construction details and technical flats to immersive digital views.</p><a href="/about" class="mt-7 inline-block font-mono text-[10px] uppercase tracking-wider text-signal">More about my background ↗</a></div>
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
    <div class="relative overflow-hidden bg-signal px-7 py-12 text-white sm:px-12 sm:py-16">
      <div class="absolute -right-10 -top-24 h-72 w-72 rounded-full border border-white/25"></div><div class="absolute -right-2 -top-16 h-56 w-56 rounded-full border border-white/25"></div>
      <div class="relative max-w-3xl"><p class="font-mono text-[9px] uppercase tracking-[.2em] text-white/75">05 / Start a conversation</p><h2 class="mt-5 font-display text-5xl leading-[.95] tracking-[-.04em] sm:text-7xl">Let's make<br/>something matter.</h2><p class="mt-6 max-w-lg text-sm leading-6 text-white/85">For apparel development, 3D visualisation, technical design or creative collaborations.</p><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-4 border border-white px-6 py-4 font-mono text-[10px] uppercase tracking-wider transition-colors hover:bg-white hover:text-signal">Message me on LinkedIn <span>↗</span></a></div>
    </div>
  </section>
</BaseLayout>
